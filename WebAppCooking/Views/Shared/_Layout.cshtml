
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppCooking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/StyleMenu.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @{
                    var isAuthenticated = Context.Session.GetString("UserId") != null;
                    var userRole = Context.Session.GetString("UserRole");
                    var recipesController = isAuthenticated
                    ? (userRole == "Admin" ? "RecipeAdmin" : "RecipeUser")
                    : "Home";
                }

                <a class="navbar-brand" asp-area="" asp-controller="@recipesController" asp-action="Index">
                    Калмыцкая кухня
                </a>

                <!-- В меню навигации -->
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        @if (userRole == "admin")
                        {
                            <a class="nav-link text-dark" asp-controller="RecipeAdmin" asp-action="Index">
                                Управление рецептами
                            </a>
                            <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">
                                Управление пользователями
                            </a>
                        }
                        else
                        {
                            <a class="nav-link text-dark" asp-controller="RecipeUser" asp-action="Index">
                                Рецепты
                            </a>
                        }
                    </li>
                }
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark">
                                    Здравствуйте, @Context.Session.GetString("UserName")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }
</body>
</html>