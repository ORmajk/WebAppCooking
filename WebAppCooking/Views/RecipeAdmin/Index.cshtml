@model IEnumerable<WebAppCooking.Models.Recipe>

@{
    ViewData["Title"] = "Управление рецептами";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Управление рецептами</title>
    <link rel="stylesheet" href="~/css/StyleAdmins.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body style="background-color: #FFAA00">
    <div class="auth-wrapper">
        <div class="auth-container" style="max-width: 1200px;">
            <div class="auth-card">
                <div class="auth-header">
                    <h4 class="auth-title" style="margin: 0; font-size: 1.5rem; font-weight: 600; color: white;">
                        Управление рецептами
                    </h4>
                </div>
                <div class="auth-body">
                    <!-- Панель фильтрации и поиска -->
                    <div class="filter-panel">
                        <form asp-action="Index" method="get" class="filter-form">
                            <!-- Поиск -->
                            <div class="search-box">
                                <input type="text"
                                       name="searchString"
                                       value="@ViewData["CurrentSearch"]"
                                       placeholder="Поиск рецептов..."
                                       class="search-input" />
                                <button type="submit" class="search-btn">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>

                            <!-- Фильтр по типу -->
                            <div class="filter-group">
                                <select name="recipeTypeId" class="filter-select" onchange="this.form.submit()">
                                    <option value="">Все типы</option>
                                    @if (ViewBag.RecipeTypes != null)
                                    {
                                        @foreach (var type in ViewBag.RecipeTypes)
                                        {
                                            <option value="@type.IdRecipeType"
                                                    selected="@(ViewData["CurrentType"]?.ToString() == type.IdRecipeType.ToString() ? "selected" : null)">
                                                @type.RecipeTypeName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Фильтр по дате -->
                            <div class="filter-group">
                                <select name="dateFilter" class="filter-select" onchange="this.form.submit()">
                                    <option value="">Все даты</option>
                                    <option value="today" selected="@(ViewData["CurrentDateFilter"]?.ToString() == "today" ? "selected" : null)">Сегодня</option>
                                    <option value="week" selected="@(ViewData["CurrentDateFilter"]?.ToString() == "week" ? "selected" : null)">За неделю</option>
                                    <option value="month" selected="@(ViewData["CurrentDateFilter"]?.ToString() == "month" ? "selected" : null)">За месяц</option>
                                    <option value="year" selected="@(ViewData["CurrentDateFilter"]?.ToString() == "year" ? "selected" : null)">За год</option>
                                </select>
                            </div>

                            <!-- Кнопка сброса -->
                            <a asp-action="Index" class="reset-btn">
                                <i class="bi bi-x-circle"></i> Сбросить
                            </a>
                        </form>
                    </div>

                    <!-- Панель сортировки -->
                    <div class="sort-panel">
                        <span class="sort-label">Сортировать по:</span>
                        <a asp-action="Index"
                           asp-route-searchString="@ViewData["CurrentSearch"]"
                           asp-route-recipeTypeId="@ViewData["CurrentType"]"
                           asp-route-dateFilter="@ViewData["CurrentDateFilter"]"
                           asp-route-sortOrder="@ViewData["NameSortParam"]"
                           class="sort-btn @(string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()) ? "active" : "")">
                            Названию
                            @if (string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))
                            {
                                <i class="bi bi-arrow-up"></i>
                            }
                            else if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                            {
                                <i class="bi bi-arrow-down"></i>
                            }
                        </a>

                        <a asp-action="Index"
                           asp-route-searchString="@ViewData["CurrentSearch"]"
                           asp-route-recipeTypeId="@ViewData["CurrentType"]"
                           asp-route-dateFilter="@ViewData["CurrentDateFilter"]"
                           asp-route-sortOrder="@ViewData["DateSortParam"]"
                           class="sort-btn @(ViewData["CurrentSort"]?.ToString() == "date" || ViewData["CurrentSort"]?.ToString() == "date_desc" ? "active" : "")">
                            Дате
                            @if (ViewData["CurrentSort"]?.ToString() == "date")
                            {
                                <i class="bi bi-arrow-up"></i>
                            }
                            else if (ViewData["CurrentSort"]?.ToString() == "date_desc")
                            {
                                <i class="bi bi-arrow-down"></i>
                            }
                        </a>

                        <a asp-action="Index"
                           asp-route-searchString="@ViewData["CurrentSearch"]"
                           asp-route-recipeTypeId="@ViewData["CurrentType"]"
                           asp-route-dateFilter="@ViewData["CurrentDateFilter"]"
                           asp-route-sortOrder="@ViewData["TypeSortParam"]"
                           class="sort-btn @(ViewData["CurrentSort"]?.ToString() == "type" || ViewData["CurrentSort"]?.ToString() == "type_desc" ? "active" : "")">
                            Типу
                            @if (ViewData["CurrentSort"]?.ToString() == "type")
                            {
                                <i class="bi bi-arrow-up"></i>
                            }
                            else if (ViewData["CurrentSort"]?.ToString() == "type_desc")
                            {
                                <i class="bi bi-arrow-down"></i>
                            }
                        </a>
                    </div>

                    <!-- Кнопка добавления -->
                    <div class="admin-toolbar" style="margin-bottom: 20px;">
                        <a asp-action="CreateRecipe" class="admin-btn-create">
                            Добавить новый рецепт
                        </a>
                    </div>

                    <!-- Результаты -->
                    @if (Model == null || !Model.Any())
                    {
                        <div class="admin-empty-state">
                            <div class="empty-state-icon"></div>
                            <h5 class="empty-state-title">Рецепты не найдены</h5>
                            <p class="empty-state-text">Нажмите кнопку "Добавить новый рецепт", чтобы создать первый рецепт</p>
                        </div>
                    }
                    else
                    {
                        <div class="admin-table-container">
                            <table class="admin-table">
                                <thead class="admin-table-header">
                                    <tr>
                                        <th class="admin-table-th">Название</th>
                                        <th class="admin-table-th">Тип</th>
                                        <th class="admin-table-th">Автор</th>
                                        <th class="admin-table-th">Дата</th>
                                        <th class="admin-table-th">Действия</th>
                                    </tr>
                                </thead>
                                <tbody class="admin-table-body">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="admin-table-row">
                                            <td class="admin-table-cell">
                                                <div class="recipe-info">
                                                    @if (!string.IsNullOrEmpty(item.RecipeImage))
                                                    {
                                                        <img src="~/images/@item.RecipeImage" alt="@item.RecipeName" class="recipe-thumbnail">
                                                    }
                                                    <span class="recipe-name">@item.RecipeName</span>
                                                </div>
                                            </td>
                                            <td class="admin-table-cell">
                                                @if (item.RecipeType != null)
                                                {
                                                    <span class="recipe-type-badge">
                                                        @item.RecipeType.RecipeTypeName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="recipe-type-badge empty">Не указан</span>
                                                }
                                            </td>
                                            <td class="admin-table-cell">
                                                @if (item.Author != null)
                                                {
                                                    <span class="recipe-author">
                                                        @item.Author.AuthorName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="recipe-author empty">Не указан</span>
                                                }
                                            </td>
                                            <td class="admin-table-cell">
                                                <span class="recipe-date">
                                                    @item.RecipeDate?.ToString("dd.MM.yyyy")
                                                </span>
                                            </td>
                                            <td class="admin-table-cell admin-actions">
                                                <a asp-action="Details" asp-route-id="@item.IdRecipe"
                                                   class="admin-action-btn admin-action-view"
                                                   style="background-color: #eab308;"
                                                   title="Просмотр">
                                                    Просмотр
                                                </a>
                                                <a asp-action="EditRecipe" asp-route-id="@item.IdRecipe"
                                                   class="admin-action-btn admin-action-edit"
                                                   style="background-color: #6b7280;"
                                                   title="Редактировать">
                                                    Редактировать
                                                </a>
                                                <a asp-action="DeleteRecipe" asp-route-id="@item.IdRecipe"
                                                   class="admin-action-btn admin-action-delete"
                                                   style="background-color: #ef4444;"
                                                   title="Удалить"
                                                   onclick="return confirm('Вы уверены, что хотите удалить этот рецепт?')">
                                                    Удалить
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="admin-table-footer">
                            <div class="table-info" style="background-color:#FF9639; color:white">
                                Всего рецептов: <span class="table-info-count" style="color:white">@Model.Count()</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>