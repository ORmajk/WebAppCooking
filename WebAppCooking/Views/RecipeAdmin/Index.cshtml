@model IEnumerable<WebAppCooking.Models.Recipe>

@{
    ViewData["Title"] = "Управление рецептами";
}

<div class="auth-wrapper">
    <div class="auth-container" style="max-width: 1200px;">
        <div class="auth-card">
            <div class="auth-header">
                <h4 class="auth-title">
                    <i class="bi bi-gear-fill"></i> Управление рецептами
                </h4>
            </div>
            <div class="auth-body">
                <div class="admin-toolbar">
                    <a asp-action="Create" class="admin-btn-create">
                        <i class="bi bi-plus-circle"></i>
                        Добавить новый рецепт
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="admin-empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5>Рецепты не найдены</h5>
                        <p>Нажмите кнопку "Добавить новый рецепт", чтобы создать первый рецепт</p>
                    </div>
                }
                else
                {
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead class="admin-table-header">
                                <tr>
                                    <th>Название</th>
                                    <th>Тип</th>
                                    <th>Автор</th>
                                    <th>Дата</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody class="admin-table-body">
                                @foreach (var item in Model)
                                {
                                    <tr class="admin-table-row">
                                        <td class="admin-table-cell">
                                            <div class="recipe-info">
                                                @if (!string.IsNullOrEmpty(item.RecipeImage))
                                                {
                                                    <img src="@item.RecipeImage" alt="" class="recipe-thumbnail">
                                                }
                                                <span class="recipe-name">@item.RecipeName</span>
                                            </div>
                                        </td>
                                        <td class="admin-table-cell">
                                            @if (item.RecipeType != null)
                                            {
                                                <span class="recipe-type-badge">
                                                    <i class="bi bi-tag"></i>
                                                    @item.RecipeType.RecipeTypeName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="recipe-type-badge empty">Не указан</span>
                                            }
                                        </td>
                                        <td class="admin-table-cell">
                                            @if (item.Author != null)
                                            {
                                                <span class="recipe-author">
                                                    <i class="bi bi-person"></i>
                                                    @item.Author.AuthorName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="recipe-author empty">Не указан</span>
                                            }
                                        </td>
                                        <td class="admin-table-cell">
                                            <span class="recipe-date">
                                                <i class="bi bi-calendar"></i>
                                                @item.RecipeDate?.ToString("dd.MM.yyyy")
                                            </span>
                                        </td>
                                        <td class="admin-table-cell actions">
                                            <a asp-action="Create" asp-route-id="@item.IdRecipe"
                                               class="action-btn view"
                                               title="Создание">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdRecipe"
                                               class="action-btn edit"
                                               title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.IdRecipe"
                                               class="action-btn delete"
                                               title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="admin-table-footer">
                        <div class="table-info">
                            Всего рецептов: <strong>@Model.Count()</strong>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}