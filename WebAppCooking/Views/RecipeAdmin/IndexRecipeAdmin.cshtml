@model IEnumerable<WebAppCooking.Models.Recipe>

@{
    ViewData["Title"] = "Управление рецептами";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход в систему</title>
    <link rel="stylesheet" href="~/css/StyleAdmins.css" />
</head>
    <body>
        <div class="auth-wrapper">
    <div class="auth-container" style="max-width: 1200px;">
        <div class="auth-card">
            <div class="auth-header">
                <h4 class="auth-title admin-title" style=" margin: 0; font-size: 1.5rem; font-weight: 600; color: white;">
                    Управление рецептами
                </h4>
            </div>
            <div class="auth-body">
                <div class="admin-toolbar">
                    <a asp-action="Create" class="admin-btn-create">
                        Добавить новый рецепт
                    </a>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="admin-empty-state">
                        <div class="empty-state-icon"></div>
                        <h5 class="empty-state-title">Рецепты не найдены</h5>
                        <p class="empty-state-text">Нажмите кнопку "Добавить новый рецепт", чтобы создать первый рецепт</p>
                    </div>
                }
                else
                {
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead class="admin-table-header">
                                <tr>
                                    <th class="admin-table-th">Название</th>
                                    <th class="admin-table-th">Тип</th>
                                    <th class="admin-table-th">Автор</th>
                                    <th class="admin-table-th">Дата</th>
                                    <th class="admin-table-th">Действия</th>
                                </tr>
                            </thead>
                            <tbody class="admin-table-body">
                                @foreach (var item in Model)
                                {
                                    <tr class="admin-table-row">
                                        <td class="admin-table-cell">
                                            <div class="recipe-info">
                                                @if (!string.IsNullOrEmpty(item.RecipeImage))
                                                {
                                                    <img src="~/images/@item.RecipeImage" alt="@item.RecipeName" class="recipe-thumbnail">
                                                }
                                                <span class="recipe-name">@item.RecipeName</span>
                                            </div>
                                        </td>
                                        <td class="admin-table-cell">
                                            @if (item.RecipeType != null)
                                            {
                                                <span class="recipe-type-badge">
                                                    @item.RecipeType.RecipeTypeName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="recipe-type-badge empty">Не указан</span>
                                            }
                                        </td>
                                        <td class="admin-table-cell">
                                            @if (item.Author != null)
                                            {
                                                <span class="recipe-author">
                                                    @item.Author.AuthorName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="recipe-author empty">Не указан</span>
                                            }
                                        </td>
                                        <td class="admin-table-cell">
                                            <span class="recipe-date">
                                                @item.RecipeDate?.ToString("dd.MM.yyyy")
                                            </span>
                                        </td>
                                        <td class="admin-table-cell admin-actions">
                                            <a asp-action="Create" asp-route-id="@item.IdRecipe"
                                               class="admin-action-btn admin-action-view"
                                               style="background-color: #eab308 "
                                               title="Создать">
                                                Создать
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdRecipe"
                                               class="admin-action-btn admin-action-edit"
                                               style="background-color: #6b7280 "
                                               title="Редактировать">
                                                Редактировать
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.IdRecipe"
                                               class="admin-action-btn admin-action-delete"
                                               style="background-color: #ef4444 "
                                               title="Удалить"
                                               onclick="return confirm('Вы уверены, что хотите удалить этот рецепт?')">
                                                Удалить
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="admin-table-footer" style="background-color:white">
                        <div class="table-info" style="background-color:#FF9639; color:white">
                            Всего рецептов: <span class="table-info-count" style="color:white">@Model.Count()</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
    </body>
</html>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}