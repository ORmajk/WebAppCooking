@model WebAppCooking.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация</title>
    <link rel="stylesheet" href="~/css/StyleHome.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-container">
            <div class="auth-card">
                <div class="auth-header">
                    <h4 class="auth-title">Регистрация</h4>
                </div>
                <div class="auth-body">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                        <div class="auth-field-group">
                            <label asp-for="Login" class="auth-label"></label>
                            <input asp-for="Login" class="auth-input" placeholder="Введите логин" />
                            <span asp-validation-for="Login" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field-group">
                            <label asp-for="Password" class="auth-label"></label>
                            <input asp-for="Password" type="password" class="auth-input" placeholder="Введите пароль" />
                            <span asp-validation-for="Password" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field-group">
                            <label asp-for="ConfirmPassword" class="auth-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Подтвердите пароль" />
                            <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field-group">
                            <label asp-for="Name" class="auth-label"></label>
                            <input asp-for="Name" class="auth-input" placeholder="Введите ваше имя" />
                            <span asp-validation-for="Name" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field-group">
                            <label asp-for="Age" class="auth-label"></label>
                            <input asp-for="Age" class="auth-input" type="number" min="1" max="120" placeholder="Введите возраст" />
                            <span asp-validation-for="Age" class="auth-field-error"></span>
                        </div>

                        <div class="auth-button-group">
                            <button type="submit" class="auth-btn-login">Зарегистрироваться</button>
                            <a asp-action="Login" class="auth-btn-register">Войти</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}