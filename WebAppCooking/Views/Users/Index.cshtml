@model IEnumerable<WebAppCooking.Models.User>

<table class="table">
    <thead>
        <tr>
            <th>Логин</th>
            <th>Пароль</th>
            <th>Имя</th>
            <th>Возраст</th>
            <th>Роль</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Login</td>
                <td>@item.Age</td>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>
                    @if (item.Role != null)
                    {
                        @item.Role.RoleName
                    }
                </td>
            </tr>
        }
    </tbody>
</table>