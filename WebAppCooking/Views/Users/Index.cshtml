@model IEnumerable<WebAppCooking.Models.User>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/StyleUsers.css" />
</head>
    <body>
        <table class="table">
            <thead>
                <tr>
                    <th>Логин</th>
                    <th>Пароль</th>
                    <th>Имя</th>
                    <th>Возраст</th>
                    <th>Роль</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Login</td>
                        <td>@item.Age</td>
                        <td>@item.Name</td>
                        <td>@item.Age</td>
                        <td>
                            @if (item.Role != null)
                            {
                                @item.Role.RoleName
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </body>
</html>