@model IEnumerable<WebAppCooking.Models.User>

<h2>Users </h2>
<div class="container">
    <table class=" table table-bordered">
        <thead class=" table-light">
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>IdRole</th>

            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <th>
                        @item.Name
                        @item.Age
                        @item.IdRole
                    </th>
                </tr>
            }
        </tbody>
    </table>
</div>
