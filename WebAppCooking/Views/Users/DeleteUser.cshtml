@model WebAppCooking.Models.Recipe

@{
    ViewData["Title"] = "Удаление рецепта";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/StyleAdmins.css" />
</head>
<body style="background-color: #FFAA00">
    <div class="auth-wrapper">
        <div class="auth-container" style="max-width: 600px;">
            <div class="auth-card">
                <div class="auth-header">
                    <h4 class="auth-title">Удаление рецепта</h4>
                </div>
                <div class="auth-body">
                    <div class="delete-confirmation">
                        <h5>Вы уверены, что хотите удалить этот рецепт?</h5>

                        <div class="recipe-details">
                            <div class="detail-item">
                                <strong>Название:</strong>
                                <span>@Model.RecipeName</span>
                            </div>
                            <div class="detail-item">
                                <strong>Описание:</strong>
                                <span>@Model.RecipeDescription</span>
                            </div>
                            <div class="detail-item">
                                <strong>Тип:</strong>
                                <span>@(Model.RecipeType?.RecipeTypeName ?? "Не указан")</span>
                            </div>
                            <div class="detail-item">
                                <strong>Автор:</strong>
                                <span>@(Model.Author?.AuthorName ?? "Не указан")</span>
                            </div>
                            <div class="detail-item">
                                <strong>Дата:</strong>
                                <span>@Model.RecipeDate?.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="IdRecipe" />
                            <div class="delete-actions">
                                <button type="submit" class="btn-delete-confirm">Удалить</button>
                                <a asp-action="Index" class="btn-cancel">Отмена</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Styles {
    <style>
        .delete-confirmation h5 {
            color: #495057;
            margin-bottom: 20px;
            text-align: center;
        }

        .recipe-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

        .detail-item {
            margin-bottom: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

            .detail-item strong {
                display: inline-block;
                width: 100px;
                color: #495057;
            }

            .detail-item span {
                color: #6c757d;
            }

        .delete-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn-delete-confirm {
            padding: 10px 30px;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-delete-confirm:hover {
                background-color: #c82333;
            }

        .btn-cancel {
            padding: 10px 30px;
            background-color: #6c757d;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-cancel:hover {
                background-color: #5a6268;
                color: white;
            }
    </style>
}