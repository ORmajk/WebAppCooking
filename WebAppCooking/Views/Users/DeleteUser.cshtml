@model WebAppCooking.Models.User

@{
    ViewData["Title"] = "Удаление пользователя";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/StyleDeleteUsers.css" />
</head>
<body style="background-color: #FFAA00">
    <div class="auth-wrapper">
        <div class="auth-container" style="max-width: 500px;">
            <div class="auth-card">
                <div class="auth-header" style="background-color: #FF9639">
                    <h4 class="auth-title">Удаление пользователя</h4>
                </div>
                <div class="auth-body">
                    <div class="delete-confirmation">
                        <h5>Вы уверены, что хотите удалить пользователя?</h5>

                        <div class="user-details">
                            <div class="detail-item">
                                <strong>Логин:</strong>
                                <span>@Model.Login</span>
                            </div>
                            <div class="detail-item">
                                <strong>Имя:</strong>
                                <span>@Model.Name</span>
                            </div>
                            <div class="detail-item">
                                <strong>Возраст:</strong>
                                <span>@Model.Age</span>
                            </div>
                            <div class="detail-item">
                                <strong>Роль:</strong>
                                <span>@(Model.Role?.RoleName ?? "Не указана")</span>
                            </div>
                        </div>

                        <form asp-action="DeleteUser" method="post">
                            <input type="hidden" asp-for="IdUser" />
                            <div class="delete-actions">
                                <button type="submit" class="btn-delete-confirm" style="background-color: #ef4444">Удалить</button>
                                <a asp-action="Index" class="btn-cancel" style="background-color: #6c757d">Отмена</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>