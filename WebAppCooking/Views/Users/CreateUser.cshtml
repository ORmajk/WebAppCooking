@model WebAppCooking.Models.Recipe

@{
    ViewData["Title"] = "Добавление рецепта";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/StyleCreateRecipe.css" />
</head>
<body style="background-color: #FFAA00">
    <div class="auth-wrapper">
        <div class="auth-container" style="max-width: 800px;">
            <div class="auth-card">
                <div class="auth-header">
                    <h4 class="auth-title">Добавление нового рецепта</h4>
                </div>
                <div class="auth-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="RecipeName" class="control-label"></label>
                            <input asp-for="RecipeName" class="form-control" />
                            <span asp-validation-for="RecipeName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="RecipeDescription" class="control-label"></label>
                            <textarea asp-for="RecipeDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="RecipeDescription" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="RecipeImage" class="control-label"></label>
                            <input asp-for="RecipeImage" class="form-control" placeholder="Например: image.jpg" />
                            <span asp-validation-for="RecipeImage" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="RecipeDate" class="control-label"></label>
                            <input asp-for="RecipeDate" class="form-control" type="date" />
                            <span asp-validation-for="RecipeDate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="IdRecipeType" class="control-label">Тип рецепта</label>
                            <select asp-for="IdRecipeType" class="form-control" asp-items="ViewBag.RecipeTypeId">
                                <option value="">Выберите тип</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="IdAuthor" class="control-label">Автор</label>
                            <select asp-for="IdAuthor" class="form-control" asp-items="ViewBag.AuthorId">
                                <option value="">Выберите автора</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Ингредиенты</label>
                            <select name="selectedIngredients" class="form-control" multiple asp-items="ViewBag.Ingredients"></select>
                            <small class="form-text text-muted">Удерживайте Ctrl для выбора нескольких ингредиентов</small>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-save">Сохранить</button>
                            <a asp-action="Index" class="btn-cancel">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
