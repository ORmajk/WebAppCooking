@model WebAppCooking.Models.User

@{
    ViewData["Title"] = "Добавление пользователя";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/StyleCreateUsers.css" />
</head>
<body style="background-color: #FFAA00">
    <div class="auth-wrapper">
        <div class="auth-container" style="max-width: 600px;">
            <div class="auth-card">
                <div class="auth-header" style="background-color: #FF9639">
                    <h4 class="auth-title">Добавление нового пользователя</h4>
                </div>
                <div class="auth-body">
                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Login" class="control-label">Логин</label>
                            <input asp-for="Login" class="form-control" />
                            <span asp-validation-for="Login" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="control-label">Пароль</label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name" class="control-label">Имя</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Age" class="control-label">Возраст</label>
                            <input asp-for="Age" class="form-control" type="number" min="1" max="120" />
                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="IdRole" class="control-label">Роль</label>
                            <select asp-for="IdRole" class="form-control" asp-items="ViewBag.Roles">
                                <option value="">Выберите роль</option>
                            </select>
                            <span asp-validation-for="IdRole" class="text-danger"></span>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-save" style="background-color: #28a745">Сохранить</button>
                            <a asp-action="Index" class="btn-cancel" style="background-color: #6c757d">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
